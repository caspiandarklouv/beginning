#include <iostream>
#include <iomanip> // Needed for setting decimal places

using namespace std;

int main() {
    double price;

    // Ask for a float number price
    cout << "Enter the price: ";
    cin >> price;

    // Multiply by 1.1 using the *= operator
    price *= 1.1;

    // Print the final value in two decimal places
    cout << fixed << setprecision(2);
    cout << "The new price is: " << price << endl;

    return 0;
}
